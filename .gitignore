.idea/
*.exe
/goleo
node_modules/
dist/
prebuilt/

# Generated by cli/npm/copy-source.js (a copy of runtime/ + go.mod + vendor/ +
# bridge/), regenerated on `npm publish` (prepublishOnly) and by scripts/setup.*.
# Not source — do not commit (it duplicates the repo and drifts).
/cli/npm/goleo/
# CLI binary built by scripts/setup.* (bin/goleo.js is source).
/cli/npm/bin/goleo
# Per-platform binary packages generated by cli/npm/build-platform-packages.js
# (built + published fresh at release time).
/cli/npm/packages/

# Spike verify apps embed a committed test fixture under frontend/dist (the path
# the runtime's asset server expects). Re-include it despite the dist/ rule above,
# or the //go:embed fails on a fresh checkout (CI) while passing locally.
!spikes/**/frontend/dist/
!spikes/**/frontend/dist/**

# Signing keys — `goleo generate android-key` writes release.jks into the working
# directory, so an accidental `git add -A` must not be able to pick one up.
*.jks
*.keystore
*.p12
*.mobileprovision

# Device/build logs pulled off a Mac or an Android host for analysis. They are
# session artifacts, not repo content — see the run entries in SPIKES.md for what
# each one found.
*.log

# A GOPATH module cache, committed by accident in the initial commit and carried
# to 0.10.13 — 812 files, 14MB of cobra/pflag/fsnotify/x/sys. Nothing referenced
# it: every GOPATH reference in this repo is `$(go env GOPATH)`, the real user
# cache. It reached the published GO MODULE (the 2.3MB under cache/download has
# no nested go.mod, so it is not excluded as a nested module), though not the npm
# packages, which copy an explicit allow-list.
#
# Scoped to /pkg/mod/ rather than /pkg/ on purpose: pkg/ is a conventional Go
# source layout, and a future package there must not be silently ignored.
/pkg/mod/

# `goleo generate types` writes to frontend/src/goleo.d.ts by default, so running it
# from THIS repo (rather than from a scaffolded project) drops a copy here. One got
# committed and then drifted unnoticed for several releases — it declared a command
# that had been removed and was missing 13 that had been added, because nothing
# regenerates or validates it. There is no frontend project in this repo; the file
# belongs in a user's project, where the CLI regenerates it on demand.
/frontend/
